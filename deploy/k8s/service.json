{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "guide",
    "namespace": "go-developers-guide",
    "labels": {
      "app.kubernetes.io/name": "go-developers-guide",
      "app.kubernetes.io/component": "server"
    }
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app.kubernetes.io/name": "go-developers-guide",
      "app.kubernetes.io/component": "server"
    },
    "ports": [
      {
        "name": "http",
        "port": 8100,
        "targetPort": "http"
      },
      {
        "name": "grpc",
        "port": 8102,
        "targetPort": "grpc"
      }
    ]
  }
}
