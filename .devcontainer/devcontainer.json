// VS Code devcontainer — the standard dev path for this repo. The full dev
// stack (this `dev` tooling container + client_dev + postgres + redis +
// mongo) is defined once in ../.docker/docker-compose.yml; VS Code attaches
// to the `dev` service and starts the whole stack with it. Server code is
// built/tested inside this container (docker exec … go build/test, Protocol
// v2); the client_dev container carries the client half at /app.
{
  "name": "go_developers_guide",
  "dockerComposeFile": "../.docker/docker-compose.yml",
  "service": "dev",
  "runServices": ["dev", "client_dev", "postgres", "redis", "mongo"],
  "workspaceFolder": "/workspaces/go_developers_guide",
  // Runs on the HOST before the container is created: compose declares the
  // three external cache volumes (gdg-go, gdg-gocache, gdg-npm), which must
  // already exist or a fresh machine's "Reopen in Container" hard-fails.
  // One create per volume (the CLI takes a single name); idempotent, so
  // re-running is a no-op.
  "initializeCommand": "docker volume create gdg-go && docker volume create gdg-gocache && docker volume create gdg-npm",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        // Go: language server (gopls bundled), debugger (dlv), test runner.
        "golang.go",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  // Phase 5 (2026-10-26): reproduce the protoc toolchain that lives OUTSIDE
  // the Go module on a container rebuild — buf is the .proto compiler host,
  // protoc-gen-go/protoc-gen-go-grpc ride the same module versions the
  // server pins (protoc-gen-go-grpc is its own nested module: its tag is the
  // plugin's, not grpc-go's). Pinned, never @latest. The codegen CLIs need
  // no entry here: oapi-codegen and gqlgen are pinned as `tool` directives
  // in server/go.mod and run via `go tool` — as do both protoc plugins.
  // `go mod download` is a warm-up (module cache rides the gdg-go volume).
  "postCreateCommand": "bash -c 'cd server && go mod download && GOBIN=/usr/local/bin go install github.com/bufbuild/buf/cmd/buf@v1.75.0 && GOBIN=/usr/local/bin go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.12 && GOBIN=/usr/local/bin go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.2'"
}
