# Production server image — multi-stage static Go build. The builder stage
# compiles ./cmd/guide with CGO disabled on the pinned golang toolchain
# (manifests first: go.mod + go.sum cache the dependency layer while only
# source churns); the final stage is distroless static — no shell, no
# package manager, no C runtime needed for a pure-Go binary — running as the
# built-in nonroot user. Build context: repo root; server/go.mod +
# server/go.sum are the required manifests.
#
# Deliberate deploy/-parity deviation: only server/ is COPYed (below), so
# the runtime deploy-stack demo's LocateDeployDir walk finds no deploy/
# artifacts beside the binary and the endpoint degrades to its honest typed
# 503 — a behavior pinned by the server's tests, not an accident.
#
# server/ code arrives in Phase 0.B — this file is authored at 0.A and
# built at 0.B close (reading-verified only until then).
FROM golang:1.27.3-bookworm AS build

WORKDIR /app

# Manifests first to leverage Docker layer caching (deps change least).
COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/ ./
# Static build: CGO off -> pure-Go static binary; -trimpath strips local
# paths; -s -w strips symbol tables and DWARF.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/guide ./cmd/guide

FROM gcr.io/distroless/static-debian12

WORKDIR /app
# Root-owned, read-only to the app user — least privilege for a single
# static binary (the exec bit survives the copy).
COPY --from=build /out/guide /app/guide

USER nonroot:nonroot
EXPOSE 8100
# Graceful shutdown comes from the server's signal handling (0.B).
ENTRYPOINT ["/app/guide"]
