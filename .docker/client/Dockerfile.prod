# Production client image — Vite build in Node, then nginx serves the SPA
# and proxies /api to the compose `server` service. Build context: repo root.
# client/package.json arrives in Phase 0.C; build verification is deferred
# until then (authored at 0.A, built at 0.C close).
FROM node:22-bookworm AS build
WORKDIR /app
# npm >= 11 keeps the prod install on the same arborist the dev image uses
# (family trap: 10.9.9 crashes on lockfile work).
RUN npm install -g npm@11
# Lockfile-first install keeps the dependency layer cacheable.
COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/ ./

# Umami analytics (PUBLIC values — the beacon URL + website id are visible
# in the served page source anyway, so these ride repository variables,
# never secrets; client/.env.example documents the same pair). Vite bakes
# import.meta.env at BUILD time, so they must be ENV before
# `npm run build`; declared here (after npm ci) so toggling them never
# invalidates the dependency layer. Empty defaults (= unset) keep
# analytics a complete no-op: no script tag injected, trackEvent sends
# nothing.
ARG VITE_UMAMI_SRC=""
ARG VITE_UMAMI_ID=""
ENV VITE_UMAMI_SRC=$VITE_UMAMI_SRC
ENV VITE_UMAMI_ID=$VITE_UMAMI_ID

RUN npm run build

FROM nginx:1.27-alpine
COPY .docker/client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
